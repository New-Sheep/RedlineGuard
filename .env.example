# RedlineGuard env — copy to `.env` (do not commit `.env`)

# First-time / PortSwigger evaluator defaults (offline, no API keys):
#   FAKE_LLM=1
#   FAKE_EMBED=1
# See docs/13-HANDOFF.md and README.md

# Embeddings: 0 = MiniLM (richer memory; may download model once)
#             1 = fast hash (recommended for first clone)
FAKE_EMBED=1

# LLM drafts + L2 judge + magical agents:
#   1 = Fake fixtures (default, zip-safe, offline)
#   0 = real LLM — pick provider below
FAKE_LLM=1

# Session auth (default on outside tests). Set 0 only for scripts.
# REQUIRE_AUTH=1

# Narrow ReAct draft agent for Needs-human (Fake always has a canned trace)
# REACT_DRAFT=1
# REACT_DRAFT_MAX_ITERS=6

# When FAKE_LLM=0:
#   auto     = first available of NVIDIA → DeepSeek → Moonshot → else Ollama
#   nvidia | deepseek | moonshot | ollama | http
LLM_PROVIDER=auto

# Local Ollama (LLM_PROVIDER=ollama, or auto with no cloud keys)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_S=120

# Cloud OpenAI-compatible keys (set in .env only — never commit)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Generic OpenAI-compatible (LLM_PROVIDER=http)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# L2 closed-book judge (confirm/drop L0+L1). Default on when FAKE_LLM=0.
# LLM_JUDGE=1
# LLM_JUDGE_MAX_FINDINGS=8

# Magical agents (empty = on when FAKE_LLM=0; Discover/GapSuggest default off)
# LLM_PLAYBOOK_PROPOSE=1
# LLM_REWRITE_COPILOT=1
# LLM_MEMORY_EXPLAIN=1
# LLM_DECISION_BRIEF=1
# LLM_MEMORY_ENRICH=1
# LLM_PLAIN_ENGLISH=1
# LLM_SCOPED_ASK=1
# LLM_GAP_SUGGEST=0
# LLM_DISCOVER=0

# Optional: Hugging Face token for faster MiniLM downloads
# HF_TOKEN=

# Decision memory
# CHROMA_COLLECTION=django_decisions_v2
# MEMORY_MAX_DISTANCE=0.45

SEMANTIC_COMPARE=1
