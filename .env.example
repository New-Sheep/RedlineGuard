# RedlineGuard env — copy to `.env` (do not commit `.env`)
# Full walkthrough: README.md · docs/14-EVALUATOR-GUIDE.md · docs/13-HANDOFF.md
#
# INTENDED demo (AI Pioneer): real generative LLM + MiniLM memory.
# You MUST fill NVIDIA_API_KEY below, OR switch to Ollama (see OLLAMA section).

# -----------------------------------------------------------------------------
# Core switches (intended values for the judged demo)
# -----------------------------------------------------------------------------
# FAKE_LLM: 0 = call a real LLM (NVIDIA/Ollama/...). 1 = canned draft fixtures only.
FAKE_LLM=0
# FAKE_EMBED: 0 = MiniLM embeddings for decision memory (~90 MB first download).
#             1 = fast hash stubs (no model download; weaker memory).
FAKE_EMBED=0

# LLM_PROVIDER: nvidia | ollama | auto | deepseek | moonshot | http
#   nvidia  = recommended for this take-home
#   auto    = first available of NVIDIA → DeepSeek → Moonshot → else Ollama
#   ollama  = fully local (no cloud key)
LLM_PROVIDER=nvidia

# -----------------------------------------------------------------------------
# NVIDIA (MUST FILL if LLM_PROVIDER=nvidia or auto-with-NVIDIA)
# Get a key at https://build.nvidia.com — never commit real keys.
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# -----------------------------------------------------------------------------
# Optional: Hugging Face (only if MiniLM download is rate-limited)
# -----------------------------------------------------------------------------
# HF_TOKEN=

# -----------------------------------------------------------------------------
# Ollama alternative (set LLM_PROVIDER=ollama; leave NVIDIA_API_KEY empty)
# Install https://ollama.com then: ollama pull qwen2.5:7b-instruct
# -----------------------------------------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_TIMEOUT_S=120

# -----------------------------------------------------------------------------
# Other cloud OpenAI-compatible providers (optional; for auto / that provider)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Agent / judge toggles (defaults are fine for first demo)
# When FAKE_LLM=0, most agents default ON; Discover/GapSuggest default OFF.
# -----------------------------------------------------------------------------
# LLM_JUDGE=1
# LLM_JUDGE_MAX_FINDINGS=8
# LLM_PLAYBOOK_PROPOSE=1
# LLM_REWRITE_COPILOT=1
# LLM_MEMORY_EXPLAIN=1
# LLM_DECISION_BRIEF=1
# LLM_MEMORY_ENRICH=1
# LLM_PLAIN_ENGLISH=1
# LLM_SCOPED_ASK=1
# LLM_GAP_SUGGEST=0
# LLM_DISCOVER=0

# Narrow ReAct draft agent for Needs-human findings
# REACT_DRAFT=1
# REACT_DRAFT_MAX_ITERS=6

# -----------------------------------------------------------------------------
# Auth and compare (leave defaults unless you know why you are changing them)
# -----------------------------------------------------------------------------
# REQUIRE_AUTH=1
# Session login required outside tests. Set 0 only for local scripts.

# L1 semantic playbook matching (regex L0 always runs)
SEMANTIC_COMPARE=1

# Decision memory
# CHROMA_COLLECTION=django_decisions_v2
# MEMORY_MAX_DISTANCE=0.45

# -----------------------------------------------------------------------------
# FALLBACK ONLY (no AI Pioneer story — UI still runs with fixture drafts)
# Uncomment both if you cannot reach NVIDIA or Ollama:
#   FAKE_LLM=1
#   FAKE_EMBED=1
# -----------------------------------------------------------------------------
