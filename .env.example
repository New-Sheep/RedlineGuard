# RedlineGuard local env example — copy to .env (do not commit .env)

# Embeddings: 0 = MiniLM (default for runserver), 1 = fast hash
# FAKE_EMBED=0

# LLM drafts for Needs-human flags: 1 = Fake fixtures (default), 0 = real HTTP API
FAKE_LLM=1
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: Hugging Face token for faster MiniLM downloads
# HF_TOKEN=

# Decision memory (Sprint 5): clause-excerpt collection + cosine distance gate
# CHROMA_COLLECTION=django_decisions_v2
# MEMORY_MAX_DISTANCE=0.45
