# RedlineGuard env — copy to `.env` (do not commit `.env`)
# See README.md and docs/13-HANDOFF.md

# =============================================================================
# INTENDED demo path (AI Pioneer / PortSwigger reviewers)
# Real generative LLM + MiniLM embeddings for decision memory.
# =============================================================================
FAKE_LLM=0
FAKE_EMBED=0

# Pick one LLM backend:
#   nvidia   — recommended; set NVIDIA_API_KEY below (build.nvidia.com)
#   auto     — first available of NVIDIA → DeepSeek → Moonshot → else Ollama
#   ollama   — fully local (install Ollama + pull a model)
#   deepseek / moonshot / http — other OpenAI-compatible APIs
LLM_PROVIDER=nvidia

# Required for LLM_PROVIDER=nvidia (or auto with NVIDIA first):
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional: Hugging Face token — helps if MiniLM download is rate-limited
# HF_TOKEN=

# Local Ollama alternative (set LLM_PROVIDER=ollama, leave NVIDIA empty):
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_TIMEOUT_S=120

# Other cloud keys (optional; used when LLM_PROVIDER=auto or that provider)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# L2 closed-book judge + magical agents default on when FAKE_LLM=0
# LLM_JUDGE=1
# LLM_JUDGE_MAX_FINDINGS=8
# LLM_PLAYBOOK_PROPOSE=1
# LLM_REWRITE_COPILOT=1
# LLM_MEMORY_EXPLAIN=1
# LLM_DECISION_BRIEF=1
# LLM_MEMORY_ENRICH=1
# LLM_PLAIN_ENGLISH=1
# LLM_SCOPED_ASK=1
# LLM_GAP_SUGGEST=0
# LLM_DISCOVER=0

# =============================================================================
# FALLBACK only — canned drafts / hash embeddings (no AI API, no MiniLM download)
# Use if you cannot reach NVIDIA/Ollama. The UI still runs; drafts are fixtures.
#   FAKE_LLM=1
#   FAKE_EMBED=1
# =============================================================================

# Session auth (default on outside tests). Set 0 only for scripts.
# REQUIRE_AUTH=1

# Narrow ReAct draft agent for Needs-human
# REACT_DRAFT=1
# REACT_DRAFT_MAX_ITERS=6

# Decision memory
# CHROMA_COLLECTION=django_decisions_v2
# MEMORY_MAX_DISTANCE=0.45

SEMANTIC_COMPARE=1
